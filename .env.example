# ─── AI EXTRACTION ────────────────────────────────────────────────────────────

# Anthropic Claude API Key — smart fallback when regex extraction finds nothing
# Used for: Impressum parsing, team page extraction, domain disambiguation
# Called ONLY as last resort (never first), ~1-2 calls per enrichment request
# Cost estimate: Sonnet = ~$0.007/call, Haiku = ~$0.0006/call
# Get key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model: start with Sonnet, switch to Haiku if costs are too high
# Sonnet: best quality extraction | Haiku: ~8x cheaper, still good for structured tasks
# Available models: claude-sonnet-4-6 | claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ─── WEB SCRAPING ─────────────────────────────────────────────────────────────

# GitHub Token (OPTIONAL but strongly recommended — 60 req/hr anon, 5000/hr with token)
# Developer emails in public commits are a goldmine for company email patterns.
# Create token: https://github.com/settings/tokens (public repos read access is enough)
GITHUB_TOKEN=

# Companies House API Key (OPTIONAL — for UK company director lookup)
# Free registration at: https://developer.company-information.service.gov.uk/
# Returns official directors/officers from the UK register. No key = OpenCorporates fallback.
COMPANIES_HOUSE_API_KEY=

# OpenRegister.de API Key (OPTIONAL — 50 free calls on free signup, no credit card)
# German commercial register: 4M+ companies, Geschäftsführer + ownership data
# Get key: https://openregister.de/en/api
OPENREGISTER_API_KEY=

# Hunter.io API Key (OPTIONAL — only needed if you want their separate database)
# The built-in email_hunter module replicates what Hunter.io does.
# Only add this if you want to cross-reference with Hunter's own crawled index.
# HUNTER_API_KEY=

# ScraperAPI Key (OPTIONAL — only needed if Google/Bing blocks your IP)
# Free tier: 1,000 requests/month
# Paid: $49/mo → 100,000 requests
# Get key: https://www.scraperapi.com/
SCRAPER_API_KEY=

# Jina AI Reader API Key (OPTIONAL — free tier works without a key, ~10 req/sec)
# Jina Reader (r.jina.ai) acts as a headless browser: bypasses JS-rendered pages,
# Cloudflare/CloudFront WAFs, and returns clean markdown — used as fallback for
# Presseportal, StepStone, and other WAF-protected German sites.
# Higher rate limits & priority queue with API key.
# Get free key at: https://jina.ai/
JINA_API_KEY=

# ─── PHONE NUMBER SOURCES ─────────────────────────────────────────────────────

# Google Maps / Places API (OPTIONAL — highly recommended for phone accuracy)
# Free: $200/month credit = ~28,000 Place Detail lookups
# Setup: Google Cloud Console → enable "Places API" → create API key
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Yelp Fusion API (OPTIONAL — free 500 req/day, great for SMBs)
# Get key: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# AbstractAPI Phone Validation (OPTIONAL — free 100 req/month)
# Adds carrier name, line type (mobile/landline), real-time validity
# Get key: https://app.abstractapi.com/api/phone-validation
ABSTRACT_PHONE_API_KEY=

# Server settings
HOST=0.0.0.0
PORT=8000

# Request settings (adjust for your network speed)
REQUEST_TIMEOUT=15
MAX_RETRIES=2
DELAY_BETWEEN_REQUESTS=1.5

# SMTP email verification settings
SMTP_TIMEOUT=10
SMTP_FROM_EMAIL=verify@yourdomain.com
